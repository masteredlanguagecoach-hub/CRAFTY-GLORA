# ==============================================================================
# CRAFTY GLORA — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME="Crafty Glora"
NEXT_PUBLIC_CURRENCY="INR"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"
NEXT_PUBLIC_WHATSAPP_NUMBER="919876543210"
NEXT_PUBLIC_CONTACT_EMAIL="support@craftyglora.com"

# ------------------------------------------------------------------------------
# RAZORPAY CONFIGURATION (Server & Client)
# ------------------------------------------------------------------------------
# Get your Key ID and Key Secret from the Razorpay Dashboard -> Settings -> API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YourTestKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpaySecretHere"

# ------------------------------------------------------------------------------
# GOOGLE SHEETS & DRIVE DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# ID found in your Google Sheet URL: https://docs.google.com/spreadsheets/d/<GOOGLE_SHEET_ID>/edit
GOOGLE_SHEET_ID=""

# Google Service Account Credentials
# Create a Service Account in Google Cloud Console -> Enable Google Sheets API & Google Drive API
# Share your Google Sheet and Google Drive folder with this service account email as Editor!
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# Optional Google Drive Folder ID for storing product media assets
GOOGLE_DRIVE_FOLDER_ID=""

# ------------------------------------------------------------------------------
# ADMIN AUTHENTICATION
# ------------------------------------------------------------------------------
ADMIN_EMAIL="admin@craftyglora.com"
# Default admin password for local development (Change in production!)
ADMIN_PASSWORD="CraftyAdmin2026!#"
ADMIN_JWT_SECRET="crafty_glora_super_secret_admin_jwt_key_2026"
